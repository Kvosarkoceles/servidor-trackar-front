# =============================================================================
# servidor-trackar-front · Variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas `.env` al repositorio (ya está en .gitignore).
# =============================================================================

# URL base de la API del backend `servidor-trackar`.
# - Desarrollo con `vercel dev` en el backend:  http://localhost:3000/api
# - Producción (Vercel):                        https://TU-DOMINIO.vercel.app/api
# Si usas el proxy de Vite, define VITE_API_PROXY_TARGET y pon aquí /api.
VITE_API_URL=http://localhost:3000/api

# (Opcional) Destino del proxy de desarrollo de Vite. Si se define, Vite
# reenvía /api -> este host, evitando CORS en local.
# VITE_API_PROXY_TARGET=http://localhost:3000

# API Key del backend (GPS_API_KEY). Es el ÚNICO mecanismo de autenticación
# que expone el backend actualmente.
# ADVERTENCIA: en una SPA esta clave viaja al navegador, por lo que cualquiera
# con acceso al bundle podría extraerla. El backend no dispone hoy de login de
# usuarios ni de tokens por usuario (ver API_INTEGRATION.md).
# Déjala vacía para que el usuario introduzca la clave en la pantalla /login.
VITE_API_KEY=

# Intervalo de refresco de posiciones en milisegundos (polling).
# El backend NO ofrece WebSocket ni SSE: la única vía de tiempo real es polling.
VITE_POSITION_REFRESH=5000

# Proveedor de mapa. Valores soportados: openstreetmap | opentopomap | carto-dark
VITE_MAP_PROVIDER=openstreetmap

# Umbral de inactividad (segundos) para considerar un dispositivo "sin conexión".
VITE_OFFLINE_THRESHOLD_SECONDS=300

# Umbral de velocidad (km/h) para considerar un dispositivo "en movimiento".
VITE_MOVING_SPEED_KMH=3

# Nº máximo de dispositivos a los que el Dashboard pedirá historial del día
# (para acotar el coste de las estadísticas agregadas).
VITE_DASHBOARD_MAX_DEVICES=25

# Nº de peticiones concurrentes contra el backend.
VITE_API_CONCURRENCY=4

# Timeout de peticiones HTTP en milisegundos.
VITE_HTTP_TIMEOUT=20000

# Valor por defecto del tema inicial: dark | light
VITE_DEFAULT_THEME=dark
